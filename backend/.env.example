CORS_ORIGINS=http://localhost:5173

# Bring Your Data upload ceilings. Fail-closed; do not remove.
CUSTOM_MAX_UPLOAD_MB=1024
CUSTOM_MAX_ROWS=2000000

# Optional Phase 3A LLM provider. Leave empty for tests and deterministic runs.
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# Razorpay TEST MODE only. Leave empty to keep the investigation workflow running
# without a sandbox order. Never set live keys. The secret must stay on the backend.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_MODE=test

# Durable governance state (decisions, proposals, approvals, simulations, audit,
# IEEE idempotency keys). One SQLite file behind the existing stores. Not a second store.
GOVERNANCE_SQLITE_PATH=data/governance.sqlite
